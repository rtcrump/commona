// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`join pages > snapshots expired, used, and revoked pages without room details > expired 1`] = `
"<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Join</title>
<link rel="stylesheet" href="/onboarding/join.css">
</head>
<body>
<main>
<p class="mark">Commona</p>
<h1>This link has expired, so ask Owner One for a new link.</h1>

</main>
</body>
</html>
"
`;

